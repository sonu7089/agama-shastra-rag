# Required for Gemini-powered enrichment and chat generation
GEMINI_API_KEY=your_gemini_api_key_here

# Required for the gated google/embeddinggemma-300m embedding model
HF_TOKEN=your_huggingface_token_here

# Required only when processing a new PDF corpus
PDF_PATH=path/to/your/book.pdf
PDF_PAGE_OFFSET=0

# Generated data locations
OUTPUT_DIR=data/outputs/Output
DB_PATH=data/chroma_db

# Notes:
# - OUTPUT_DIR should point to the parent directory that contains per-book folders.
# - DB_PATH is the local Chroma persistent directory used by the retriever and Streamlit app.
